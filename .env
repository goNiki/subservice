#SERVER
SERVER_HOST=localhost
SERVER_PORT=8081

#LOGGER
LOGGER_LEVEL=local                  #local, dev, prod
LOGGER_CONSOLE_ENABLED=true
LOGGER_CONSOLE_FORMAT=json          # json, text
LOGGER_CONSOLE_OUTPUT=stdout        # stdout, stderr, file
LOGGER_FILE_ENABLED=true
LOGGER_FILE_FORMAT=json
LOGGER_FILE_PATH=./logs/app.log     # путь к файлу логов (если OUTPUT=file)



#Postgres 
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=subservice
DB_SSLMODE=disable
DB_MAXCONNS=20
DB_MINCONNS=5
DB_MAXCONNLIFETIME=30m
DB_MAXCONNIDLETIME=5m
DB_HEALTHCHECKPERIOD=1m